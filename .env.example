# Servidor FastAPI y Seguridad
APP_HOST=0.0.0.0
APP_PORT=8000
MAX_UPLOAD_MB=50
CORS_ORIGINS=*

# Rutas locales
DOCUMENTS_DIR=./documents
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=rag_conductor

# Chunking y Recuperacion (RAG)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_SIMILARITY_SCORE=0.30

# Proveedor Primario y Fallbacks (ollama | together)
LLM_PRIMARY=ollama
LLM_FALLBACK_ENABLED=true
# Recomendado false para evitar incompatibilidad de dimensiones en ChromaDB
# salvo que ambos modelos de embedding generen la misma dimension.
EMBEDDING_FALLBACK_ENABLED=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Ollama Local
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# Together.ai (Fallback / Cloud)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
